# LEAKLOCK — Example Environment Configuration
# Copy this file to .env for local customization.
# Never commit .env to version control (it is already in .gitignore).

# Application environment
LEAKLOCK_ENV=development

# Current development phase label (shown in settings)
LEAKLOCK_PHASE=Phase 2 Enhanced: Detection, Policy & Audit

# Decision backend: 'software_fallback' (default) or 'verilog_controller' (Phase 3)
LEAKLOCK_DECISION_BACKEND=software_fallback

# Privacy: set to 'false' to keep prompts out of any log output (recommended)
LEAKLOCK_LOG_PROMPTS=false

# Server bind address (default: 127.0.0.1 — localhost only, not public-facing)
# Change to 0.0.0.0 only if you have a firewall protecting the port.
LEAKLOCK_HOST=127.0.0.1

# Server port (default: 8501)
LEAKLOCK_PORT=8501
